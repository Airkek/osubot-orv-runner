# Volume Paths
RENDERS_DIR=./renders
FAILED_REPLAYS_DIR=./failed_replays
ORV_DATA_DIR=./orv-data

# Optional in-container overrides for read-only Realm lookups
OSU_LAZER_STORAGE_PATH=/root/.local/share/osu_replay_viewer
# OSU_LAZER_REALM_PATH=/root/.local/share/osu_replay_viewer/client_52.realm

# Optional: Official osu! API v1 key for metadata lookup (enables provider only if specified)
OSU_API_V1_KEY=
